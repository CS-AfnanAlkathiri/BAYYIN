# BAYYIN runs without private API keys.
BAYYIN_ENV=development

# Approved live source retrieval layer (enabled by default)
BAYYIN_LIVE_SOURCES=on
BAYYIN_SOURCE_API_TIMEOUT=5

# Qur'an primary text / explicit-reference verification
BAYYIN_QURAN_API=https://api.quranpedia.net/v1

# Preferred English Qur'an translation source from the latest scientific package
BAYYIN_QURANENC_API=https://quranenc.com/api/v1
BAYYIN_QURANENC_TRANSLATION_KEY=english_saheeh

# Hadith search / trace fallback
BAYYIN_DORAR_API=https://dorar.net/dorar_api.json

# Bounded AI/NLP retrieval layer (enabled by default)
# AI retrieval backend. Default LSA is fully offline and reproducible.
BAYYIN_AI_RETRIEVAL=on
BAYYIN_AI_BACKEND=lsa
# Optional after installing requirements-embeddings.txt and pre-downloading the model:
# BAYYIN_AI_BACKEND=bge-m3
# BAYYIN_EMBEDDING_MODEL=BAAI/bge-m3


# Bounded RAG generation layer (automatic by default)
# No on/off switch is required. If the three provider settings below are present,
# BAYYIN uses RAG automatically. If they are missing or the provider fails,
# BAYYIN falls back safely to the verified evidence report.
BAYYIN_RAG_API_BASE=
BAYYIN_RAG_API_KEY=
BAYYIN_RAG_MODEL=
BAYYIN_RAG_TIMEOUT=30
BAYYIN_RAG_MAX_TOKENS=220
